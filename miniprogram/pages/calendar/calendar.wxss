.page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #1a5fb4;
  border-radius: 50%;
  font-size: 40rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.calendar {
  padding: 20rpx 12rpx 16rpx;
  margin-bottom: 24rpx;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 40rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 8rpx;
}

.cell-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
}

.cell {
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 16rpx;
  color: #1f2937;
}

.day-num {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 500;
}

.mark {
  flex-shrink: 0;
  background: #3584e4;
}

.mark-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.mark-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-count {
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
}

.cell.today .day-num {
  color: #1a5fb4;
  font-weight: 700;
}

.cell.today:not(.selected) {
  box-shadow: inset 0 0 0 2rpx #93c5fd;
}

.cell.selected {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(26, 95, 180, 0.28);
}

.cell.selected .day-num {
  color: #fff;
  font-weight: 700;
}

.cell.selected .mark-dot {
  background: rgba(255, 255, 255, 0.95);
}

.cell.selected .mark-badge {
  background: rgba(255, 255, 255, 0.95);
}

.cell.selected .mark-count {
  color: #1a5fb4;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.empty {
  color: #9ca3af;
  font-size: 26rpx;
  padding: 24rpx 0;
}
