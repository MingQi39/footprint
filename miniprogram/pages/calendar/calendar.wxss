.page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #1a5fb4;
  border-radius: 50%;
  font-size: 40rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.weekdays,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekdays {
  margin-bottom: 12rpx;
  text-align: center;
  color: #8a94a6;
}

.grid {
  padding: 12rpx;
  margin-bottom: 24rpx;
}

.cell {
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
}

.cell.selected {
  background: #eef4ff;
  color: #1a5fb4;
  font-weight: 700;
}

.dot {
  position: absolute;
  bottom: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #1a5fb4;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}
