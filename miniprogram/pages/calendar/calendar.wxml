<view class="page">
  <view class="card header">
    <view class="nav" data-delta="-1" bindtap="changeMonth">‹</view>
    <view class="title">{{year}}年{{month}}月</view>
    <view class="nav" data-delta="1" bindtap="changeMonth">›</view>
  </view>

  <view class="calendar card">
    <view class="weekdays">
      <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="weekday">{{item}}</text>
    </view>

    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="cell-wrap"
      >
        <view
          wx:if="{{!item.empty}}"
          class="cell {{selectedDate === item.date ? 'selected' : ''}} {{item.isToday ? 'today' : ''}} {{item.marked ? 'marked' : ''}}"
          data-date="{{item.date}}"
          bindtap="selectDay"
        >
          <text class="day-num">{{item.day}}</text>
          <view
            wx:if="{{item.marked}}"
            class="mark {{item.count > 1 ? 'mark-badge' : 'mark-dot'}}"
          >
            <text wx:if="{{item.count > 1}}" class="mark-count">{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{selectedDate}}">
    <view class="section-title">{{selectedDate}} 的记录</view>
    <view wx:if="{{!dayList.length}}" class="empty">这一天还没有足迹</view>
    <view
      class="item card"
      wx:for="{{dayList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="name">{{item.name}}</view>
      <view class="meta">{{item.placeMeta}} · {{item.photoCount}} 张照片</view>
    </view>
  </view>
</view>
