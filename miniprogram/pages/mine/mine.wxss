.page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.avatar-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef4ff;
  display: block;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  font-size: 34rpx;
  font-weight: 700;
  height: 48rpx;
  line-height: 48rpx;
  color: #111827;
}

.sub {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.actions {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ghost {
  background: #eef4ff;
  color: #1a5fb4;
}
