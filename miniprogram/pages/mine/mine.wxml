<view class="page">
  <view class="card profile">
    <view class="avatar">👤</view>
    <view>
      <view class="name">{{user.nickname || '未登录用户'}}</view>
      <view class="sub">记录每一步走过的风景</view>
    </view>
  </view>

  <view class="card actions">
    <button bindtap="goCheckin">新增打卡</button>
    <button bindtap="relogin">重新登录</button>
    <button class="ghost" bindtap="logout">退出登录</button>
  </view>
</view>
