<view class="page">
  <view class="card profile">
    <button
      class="avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      disabled="{{saving}}"
    >
      <image
        wx:if="{{avatarPreview || user.avatarUrl}}"
        class="avatar-img"
        src="{{avatarPreview || user.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar">👤</view>
    </button>
    <view class="profile-info">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击设置昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        disabled="{{saving}}"
      />
      <view class="sub">点击头像更换 · 昵称同步微信</view>
    </view>
  </view>

  <view class="card actions">
    <button bindtap="goCheckin">新增打卡</button>
    <button bindtap="relogin">重新登录</button>
    <button class="ghost" bindtap="logout">退出登录</button>
  </view>
</view>
