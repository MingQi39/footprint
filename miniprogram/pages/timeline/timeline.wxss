.page {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item {
  display: flex;
  overflow: hidden;
}

.cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.content {
  padding: 24rpx;
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.meta,
.time {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 95, 180, 0.35);
}
