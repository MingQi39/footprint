.page {
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
}

.btn.ghost {
  background: #eef4ff;
  color: #1a5fb4;
}
