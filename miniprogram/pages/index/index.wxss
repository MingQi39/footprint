.page {
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.map-tools {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 2;
}

.map-tool-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #1a5fb4;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 95, 180, 0.12);
}

.map-tool-btn::after {
  border: none;
}

.overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
}

.btn.ghost {
  background: #eef4ff;
  color: #1a5fb4;
}
