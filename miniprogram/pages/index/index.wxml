<view class="page">
  <map
    id="footprintMap"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
  />

  <view class="map-tools" wx:if="{{markers.length}}">
    <button class="map-tool-btn" bindtap="fitAllFootprints">看全足迹</button>
    <button class="map-tool-btn" bindtap="moveMapToUserLocation">我的位置</button>
  </view>

  <view class="overlay card">
    <view class="title">我的足迹</view>
    <view class="sub" wx:if="{{countryText}}">已到访：{{countryText}}</view>
    <view class="sub" wx:if="{{provinceText}}">国内：{{provinceText}}</view>
    <view class="sub" wx:if="{{!countryText && !provinceText}}">还没有足迹，去打卡第一个地点吧</view>
    <view class="actions">
      <button class="btn ghost" bindtap="goSearch">搜索地点</button>
      <button class="btn primary" bindtap="goCheckin">立即打卡</button>
    </view>
  </view>
</view>
