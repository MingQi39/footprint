.page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  border-top: 6rpx solid #3584e4;
}

.block {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.place-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: #eef4fc;
  color: #1a5fb4;
  font-size: 24rpx;
  font-weight: 600;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #111827;
}

.addr {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6b7280;
}

.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.time-label {
  font-size: 26rpx;
  color: #8a94a6;
}

.time-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #111827;
}

.note-body {
  font-size: 28rpx;
  line-height: 1.6;
  color: #374151;
  white-space: pre-wrap;
}

.note-meta {
  margin-top: 8rpx;
}

.note-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.note-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.note-k {
  flex-shrink: 0;
  width: 88rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.note-v {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  color: #374151;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #eef2f7;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.action-btn {
  width: 100% !important;
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn::after {
  border: none;
}

.primary {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
}

.danger {
  background: #fff;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}
