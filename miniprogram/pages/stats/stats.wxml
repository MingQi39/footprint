<view class="page">
  <view wx:if="{{stats}}" class="grid">
    <view class="card stat">
      <view class="num">{{stats.totalCheckins}}</view>
      <view class="label">总打卡</view>
    </view>
    <view class="card stat">
      <view class="num">{{stats.totalCities}}</view>
      <view class="label">城市数</view>
    </view>
    <view class="card stat">
      <view class="num">{{stats.totalProvinces}}</view>
      <view class="label">省份数</view>
    </view>
    <view class="card stat">
      <view class="num">{{stats.totalPhotos}}</view>
      <view class="label">照片数</view>
    </view>
  </view>

  <view class="card range" wx:if="{{stats}}">
    <view class="row">
      <text>首次足迹</text>
      <text>{{stats.firstCheckinAtText || '暂无'}}</text>
    </view>
    <view class="row">
      <text>最近足迹</text>
      <text>{{stats.latestCheckinAtText || '暂无'}}</text>
    </view>
  </view>
</view>
