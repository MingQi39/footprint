.page {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.block {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.meta {
  margin-top: 8rpx;
  color: #1a5fb4;
  font-size: 26rpx;
}

.addr {
  margin-top: 8rpx;
  color: #6b7280;
}

.pick-btn,
.submit {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
}

.row {
  display: flex;
  gap: 16rpx;
}

.picker {
  background: #f3f6fb;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}

.note {
  width: 100%;
  min-height: 160rpx;
  background: #f3f6fb;
  padding: 16rpx;
  border-radius: 12rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #eef2f7;
}

.photo.add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #8a94a6;
}

.submit {
  margin-top: 12rpx;
}
