page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(26, 95, 180, 0.08);
}

.primary-btn {
  background: linear-gradient(135deg, #1a5fb4, #3584e4);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8a94a6;
}
