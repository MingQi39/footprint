# 服务
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# MySQL
DATABASE_URL=mysql://footprint:footprint123@localhost:3307/footprint

# 微信小程序
WX_APPID=
WX_SECRET=

# 开发模式：无微信凭证时使用 dev 登录
DEV_MODE=true

# 腾讯地图（服务端 Key，用于 POI 搜索 / 逆地理编码）
TENCENT_MAP_KEY=

# 文件上传：local（本地存储）或 oss（阿里云 OSS）
UPLOAD_MODE=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# 阿里云 OSS（UPLOAD_MODE=oss 时填写）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_CDN_DOMAIN=
